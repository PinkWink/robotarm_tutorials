<?xml version="1.0"?>
<!--
  Wraps fr3_gazebo.urdf.xacro and adds an Intel RealSense D435 attached
  to fr3_hand. Everything D435-related is defined here — franka_description
  and franka_fr3_moveit_config remain untouched.

  Frames added:
    fr3_hand
     └── d435_link                 (camera body, +X = view direction)
          ├── d435_depth_optical_frame   (REP-105 optical: z forward)
          └── d435_color_optical_frame   (REP-105 optical: z forward)

  A Gazebo camera sensor on d435_link publishes /d435/color/image_raw on
  the Gazebo transport. The companion launch file bridges it to ROS via
  ros_gz_bridge.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3_with_d435">

  <xacro:include filename="$(find franka_tutorials)/urdf/fr3_gazebo.urdf.xacro"/>

  <!-- Mount: fr3_hand -> d435_link
       Position: 5 cm along the gripper direction (fr3_hand's +Z axis).
       Orientation: rpy=(0, -pi/2, 0) makes d435_link's +X = fr3_hand's +Z,
       so the Gazebo camera's default view (along the body +X) points
       OUT of the gripper (forward), not back toward the robot. -->
  <joint name="d435_mount_joint" type="fixed">
    <parent link="fr3_hand"/>
    <child link="d435_link"/>
    <origin xyz="0 0 0.05" rpy="0 -1.5707963 0"/>
  </joint>

  <link name="d435_link">
    <visual>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="d435_dark">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.072"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <gazebo reference="d435_link"><gravity>false</gravity></gazebo>

  <!-- Optical frames per REP-105 (z forward, x right, y down) -->
  <joint name="d435_depth_optical_joint" type="fixed">
    <parent link="d435_link"/>
    <child link="d435_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>
  <link name="d435_depth_optical_frame"/>

  <joint name="d435_color_optical_joint" type="fixed">
    <parent link="d435_link"/>
    <child link="d435_color_optical_frame"/>
    <origin xyz="0 -0.015 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>
  <link name="d435_color_optical_frame"/>

  <!-- Gazebo camera sensor.
       Attached to d435_link; the camera's default view axis is the link's +X.
       The image messages will use d435_color_optical_frame as frame_id. -->
  <gazebo reference="d435_link">
    <sensor name="d435_color" type="camera">
      <camera>
        <horizontal_fov>1.21126</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>d435/color/image_raw</topic>
      <gz_frame_id>d435_color_optical_frame</gz_frame_id>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

</robot>
